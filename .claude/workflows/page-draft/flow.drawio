<mxfile host="page-draft/build-drawio.mjs" modified="2026-09-05T00:00:00.000Z" version="24.0.0">
  <diagram id="page-draft" name="page-draft">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="P1" value="1. Take the page" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#868e96;fontColor=#868e96;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="-620" y="80" width="1240" height="560" as="geometry"/></mxCell>
        <mxCell id="P2" value="2. Research: 5 agents at once (all sonnet)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7f0fb;strokeColor=#2c88d9;fontColor=#2c88d9;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="-740" y="680" width="1480" height="180" as="geometry"/></mxCell>
        <mxCell id="P3" value="3. Plan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e8fb;strokeColor=#9c36b5;fontColor=#9c36b5;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="-1080" y="900" width="1700" height="580" as="geometry"/></mxCell>
        <mxCell id="P4" value="4. Build" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff1e6;strokeColor=#e8833a;fontColor=#e8833a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="-620" y="1540" width="1700" height="1600" as="geometry"/></mxCell>
        <mxCell id="P5" value="5. Hand over to Ovi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f7f2;strokeColor=#207868;fontColor=#207868;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="-620" y="3180" width="1240" height="220" as="geometry"/></mxCell>
        <mxCell id="start" value="Start: Ovi names a page" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#788896;strokeColor=#1e1e1e;fontColor=#fff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-140" y="0" width="280" height="52" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;Every AGENT box is a new agent with an empty memory. It knows only what the script hands it, and what is on disk, on GitHub, in Sanity, on Basecamp. A box that runs again is a new agent again.&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#b8a200;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="670" y="-40" width="420" height="128.94736842105263" as="geometry"/></mxCell>
        <mxCell id="claim" value="&lt;b&gt;AGENT: take the page (sonnet)&lt;/b&gt;&lt;br&gt;Find the page's Basecamp card. If nobody else has it, mark it in progress with this branch name" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-160" y="110" width="320" height="115.21052631578947" as="geometry"/></mxCell>
        <mxCell id="q1" value="SCRIPT checks: did we get the page?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-150" y="300" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="stop" value="Stop. Touch nothing." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-560" y="340" width="280" height="52" as="geometry"/></mxCell>
        <mxCell id="q2" value="SCRIPT checks: has the plan for this page already been written?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-150" y="480" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="gA" value="&lt;b&gt;AGENT: research A&lt;/b&gt;&lt;br&gt;Who the page is for, and the writing rules" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-710" y="720" width="260" height="84.42105263157895" as="geometry"/></mxCell>
        <mxCell id="gB" value="&lt;b&gt;AGENT: research B&lt;/b&gt;&lt;br&gt;What the old page says" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-420" y="720" width="260" height="74.94736842105263" as="geometry"/></mxCell>
        <mxCell id="gC" value="&lt;b&gt;AGENT: research C&lt;/b&gt;&lt;br&gt;Related blog posts, and the pages next to it in the menu" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-130" y="720" width="260" height="91.05263157894737" as="geometry"/></mxCell>
        <mxCell id="gD" value="&lt;b&gt;AGENT: research D&lt;/b&gt;&lt;br&gt;Which page sections exist, and the design rules" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="160" y="720" width="260" height="86.78947368421052" as="geometry"/></mxCell>
        <mxCell id="gE" value="&lt;b&gt;AGENT: research E&lt;/b&gt;&lt;br&gt;Which photos exist" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="450" y="720" width="260" height="73.05263157894737" as="geometry"/></mxCell>
        <mxCell id="readPlan" value="&lt;b&gt;AGENT: read the plan (sonnet)&lt;/b&gt;&lt;br&gt;Reads the plan that is already written" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-1060" y="1120" width="320" height="88.21052631578948" as="geometry"/></mxCell>
        <mxCell id="writePlan" value="&lt;b&gt;AGENT: write the plan (session model)&lt;/b&gt;&lt;br&gt;Write the plan as a GitHub issue and link it on the card" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-160" y="960" width="320" height="100.52631578947368" as="geometry"/></mxCell>
        <mxCell id="secondReader" value="&lt;b&gt;AGENT: second reader (session model, high effort)&lt;/b&gt;&lt;br&gt;Reads the plan as the parent it is written for, and lists the problems. A new agent each round" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-160" y="1120" width="320" height="124.21052631578947" as="geometry"/></mxCell>
        <mxCell id="q3" value="SCRIPT checks: found problems? Up to 3 rounds" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-150" y="1300" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="fixPlan" value="&lt;b&gt;AGENT: fix the plan (session model)&lt;/b&gt;&lt;br&gt;Applies the fixes to the issue. A new agent each round" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="1200" width="320" height="98.63157894736841" as="geometry"/></mxCell>
        <mxCell id="getReady" value="&lt;b&gt;AGENT: get ready (sonnet)&lt;/b&gt;&lt;br&gt;Get the latest code, check nobody else is editing the same sections, back up the content database" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-160" y="1600" width="320" height="114.26315789473684" as="geometry"/></mxCell>
        <mxCell id="q4" value="SCRIPT checks: latest code pulled, backup made and checked?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-150" y="1790" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="buildSection" value="&lt;b&gt;AGENT: build one section (session model)&lt;/b&gt;&lt;br&gt;A new agent for each new or redesigned section, one after the other. None of them sees what the one before it did, only its files" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-160" y="1960" width="320" height="136.5263157894737" as="geometry"/></mxCell>
        <mxCell id="writeText" value="&lt;b&gt;AGENT: write the page text (session model)&lt;/b&gt;&lt;br&gt;Write the text and save it as a draft in Sanity" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-160" y="2120" width="320" height="98.63157894736841" as="geometry"/></mxCell>
        <mxCell id="proofread" value="&lt;b&gt;AGENT: proofread (session model, high effort)&lt;/b&gt;&lt;br&gt;Voice, banned words, unconfirmed facts, colours alternate, buttons in place. A new agent each round" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-160" y="2280" width="320" height="124.6842105263158" as="geometry"/></mxCell>
        <mxCell id="q5" value="SCRIPT checks: found problems? Up to 3 rounds" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-150" y="2470" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="fix" value="&lt;b&gt;AGENT: fix (session model)&lt;/b&gt;&lt;br&gt;Fix them and save again. A new agent each round" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="2370" width="320" height="91.05263157894737" as="geometry"/></mxCell>
        <mxCell id="loadPage" value="&lt;b&gt;AGENT: load the page (sonnet, low effort)&lt;/b&gt;&lt;br&gt;Load the page on the dev server and check every section shows up" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-160" y="2650" width="320" height="106.21052631578947" as="geometry"/></mxCell>
        <mxCell id="q6" value="SCRIPT checks: page loads?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-150" y="2840" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="fixLoad" value="&lt;b&gt;AGENT: fix (session model)&lt;/b&gt;&lt;br&gt;Fix it, one try" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="2740" width="320" height="75.89473684210526" as="geometry"/></mxCell>
        <mxCell id="push" value="&lt;b&gt;AGENT: push the code (sonnet)&lt;/b&gt;&lt;br&gt;Final checks, then push" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-160" y="3020" width="320" height="81.10526315789474" as="geometry"/></mxCell>
        <mxCell id="giveUp" value="&lt;b&gt;AGENT: give up (haiku)&lt;/b&gt;&lt;br&gt;Writes what went wrong on the card and leaves it marked in progress" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d3455b;strokeColor=#a02a3c;fontColor=#fff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="2300" width="320" height="98.63157894736841" as="geometry"/></mxCell>
        <mxCell id="handOver" value="&lt;b&gt;AGENT: hand over (sonnet)&lt;/b&gt;&lt;br&gt;Move the card to Ovi Polish. Write on the card what to look at, what was guessed, what to ask the camp. Make the to-do list of things the camp must supply" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fontColor=#1e1e1e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-160" y="3220" width="320" height="141.26315789473682" as="geometry"/></mxCell>
        <mxCell id="done" value="Draft ready for Ovi" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#207868;strokeColor=#1e1e1e;fontColor=#fff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-140" y="3440" width="280" height="52" as="geometry"/></mxCell>
